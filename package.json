      },
      {
        "command": "databaseTools.runStatement",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "databaseTools.sqlTab && editorTextFocus"
      },
      {
        "command": "databaseTools.cancelQuery",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "databaseTools.running"
      },
      {
        "command": "databaseTools.explainPlan",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "databaseTools.sqlTab && editorTextFocus"
      },
      {
        "command": "databaseTools.formatQuery",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "databaseTools.sqlTab && editorTextFocus && editorLangId == sql"
      }
