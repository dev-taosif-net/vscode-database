    "configuration": {
      "title": "Database Tools",
      "properties": {
        "databaseTools.connectTimeout": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 600,
          "description": "Seconds to wait for a new connection before giving up. Used as the default for new connection profiles."
        },
        "databaseTools.rowsPerFetch": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "maximum": 100000,
          "description": "Rows fetched per page. Used as the default for new connection profiles."
        },
        "databaseTools.confirmProductionConnect": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before opening a session against a connection marked as Production."
        },
        "databaseTools.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current file's connection in the status bar, coloured by its environment."
        },
        "databaseTools.executionSessions": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Execution sessions one connection may hold at once. Each is a separate connection to the server, opened only when a tab first runs something. The catalog keeps a session of its own that is never counted here, so browsing the tree stays responsive while a query runs."
        },
        "databaseTools.confirmProductionWrite": {
          "type": "boolean",
          "default": true,
          "description": "Ask before running anything that writes against a connection marked as Production. This is separate from the confirmation before connecting: consenting to look at production is not consenting to change it."
        },
        "databaseTools.savedQueryFolder": {
          "type": "string",
          "default": ".database/queries",
          "description": "Where saved queries are written, relative to the first workspace folder. They are ordinary .sql files, so they diff and review like any other source. Without a folder open they go to the extension's global storage instead."
        },
        "databaseTools.format.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "How SQL keywords are cased by the formatter."
        },
        "databaseTools.format.commas": {
          "type": "string",
          "enum": [
            "trailing",
            "leading"
          ],
          "default": "trailing",
          "description": "Whether a list's commas end a line or begin the next one."
        },
        "databaseTools.format.leadingBoolean": {
          "type": "boolean",
          "default": true,
          "description": "Start a line with AND or OR rather than trailing the line before it."
        },
        "databaseTools.completion.keywordSpace": {
          "type": "boolean",
          "default": true,
          "description": "Follow an accepted keyword with a space and re-open the suggestion list, so SELECT and FROM do not each cost a trip to the space bar. Words that end a phrase, such as END and DESC, are left alone, and the aggregate functions take an opening parenthesis instead."
        },
        "databaseTools.completion.tableAlias": {
          "type": "boolean",
          "default": true,
          "description": "Give a table an alias when it is accepted in FROM or JOIN, taken from the capitals in its name: empManualAttendanceSummary becomes mas. A second copy of the same table in one statement is numbered. Aliases already in scope are then offered first in the list."
        }
      }
    },
