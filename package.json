          "light": "#14682c",
          "highContrast": "#5fd97a",
          "highContrastLight": "#0d5c22"
        }
      },
      {
        "id": "databaseTools.statusBarItem.qaForeground",
        "description": "Colour of the status bar entry for a QA connection.",
        "defaults": {
          "dark": "#6aa9f5",
          "light": "#0a52ad",
          "highContrast": "#7cb8ff",
          "highContrastLight": "#003f9e"
        }
      },
      {
        "id": "databaseTools.statusBarItem.uatForeground",
        "description": "Colour of the status bar entry for a UAT connection. Unused while the entry carries the theme’s own warning background.",
