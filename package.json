{
  "name": "vscode-database-tools",
  "displayName": "Database Tools",
  "description": "Fast, lightweight SQL Server and PostgreSQL tooling inside VS Code.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "dev-taosif-net",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql server",
    "mssql",
    "postgresql",
    "postgres",
    "database"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "databaseTools.openConnections",
        "title": "Connections: Open",
        "category": "Database",
        "icon": "$(database)"
      },
      {
        "command": "databaseTools.newConnection",
        "title": "Connections: New",
        "category": "Database",
        "icon": "$(add)"
      },
      {
        "command": "databaseTools.filterConnections",
        "title": "Search Connections",
        "category": "Database",
        "icon": "$(search)"
      },
      {
        "command": "databaseTools.refreshConnections",
        "title": "Refresh Connections",
        "category": "Database",
        "icon": "$(refresh)"
      },
      {
        "command": "databaseTools.viewOptions",
        "title": "Connections: View Options",
        "category": "Database",
        "icon": "$(filter)"
      },
      {
        "command": "databaseTools.clearFilter",
        "title": "Clear the Connection Filter",
        "category": "Database",
        "icon": "$(clear-all)"
      },
      {
        "command": "databaseTools.groupByEnvironment",
        "title": "Group Connections by Environment",
        "category": "Database",
        "icon": "$(list-tree)"
      },
      {
        "command": "databaseTools.showFlatList",
        "title": "Show Connections as a Flat List",
        "category": "Database",
        "icon": "$(list-flat)"
      },
      {
        "command": "databaseTools.collapseAllGroups",
        "title": "Collapse All Connection Groups",
        "category": "Database",
        "icon": "$(collapse-all)"
      },
      {
        "command": "databaseTools.connect",
        "title": "Connect",
        "category": "Database",
        "icon": "$(plug)"
      },
      {
        "command": "databaseTools.disconnect",
        "title": "Disconnect",
        "category": "Database",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "databaseTools.disconnectAll",
        "title": "Disconnect All",
        "category": "Database",
        "icon": "$(close-all)"
      },
      {
        "command": "databaseTools.deleteConnection",
        "title": "Delete Connection",
        "category": "Database",
        "icon": "$(trash)"
      },
      {
        "command": "databaseTools.editConnection",
        "title": "Edit Connection",
        "category": "Database",
        "icon": "$(edit)"
      },
      {
        "command": "databaseTools.addFavourite",
        "title": "Add to Favourites",
        "category": "Database",
        "icon": "$(star-add)"
      },
      {
        "command": "databaseTools.removeFavourite",
        "title": "Remove from Favourites",
        "category": "Database",
        "icon": "$(star-delete)"
      },
      {
        "command": "databaseTools.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "Database",
        "icon": "$(files)"
      },
      {
        "command": "databaseTools.copyServerAddress",
        "title": "Copy Server Address",
        "category": "Database",
        "icon": "$(copy)"
      },
      {
        "command": "databaseTools.refreshCatalog",
        "title": "Refresh Objects",
        "category": "Database",
        "icon": "$(refresh)"
      },
      {
        "command": "databaseTools.enableSchemaMode",
        "title": "Enable Schema Focused Mode",
        "category": "Database",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "databaseTools.disableSchemaMode",
        "title": "Disable Schema Focused Mode",
        "category": "Database",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "databaseTools.openDefinition",
        "title": "Open Definition",
        "category": "Database",
        "icon": "$(go-to-file)"
      },
      {
        "command": "databaseTools.selectTop100",
        "title": "Select Top 100",
        "category": "Database",
        "icon": "$(table)"
      },
      {
        "command": "databaseTools.generateCrud",
        "title": "Generate CRUD",
        "category": "Database",
        "icon": "$(symbol-method)"
      },
      {
        "command": "databaseTools.executeObject",
        "title": "Execute",
        "category": "Database",
        "icon": "$(play)"
      },
      {
        "command": "databaseTools.scriptAsAlter",
        "title": "Script As ALTER",
        "category": "Database",
        "icon": "$(edit)"
      },
      {
        "command": "databaseTools.copyObjectName",
        "title": "Copy Name",
        "category": "Database",
        "icon": "$(copy)"
      },
      {
        "command": "databaseTools.copyObjectFullName",
        "title": "Copy Full Name",
        "category": "Database",
        "icon": "$(copy)"
      },
      {
        "command": "databaseTools.addObjectFavourite",
        "title": "Add to Favourites",
        "category": "Database",
        "icon": "$(star-add)"
      },
      {
        "command": "databaseTools.removeObjectFavourite",
        "title": "Remove from Favourites",
        "category": "Database",
        "icon": "$(star-delete)"
      }
    ],
    "configuration": {
      "title": "Database Tools",
      "properties": {
        "databaseTools.connectTimeout": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 600,
          "description": "Seconds to wait for a new connection before giving up. Used as the default for new connection profiles."
        },
        "databaseTools.rowsPerFetch": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "maximum": 100000,
          "description": "Rows fetched per page. Used as the default for new connection profiles."
        },
        "databaseTools.confirmProductionConnect": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before opening a session against a connection marked as Production."
        },
        "databaseTools.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active connection in the status bar, tinted by its environment."
        }
      }
    },
    "keybindings": [
      {
        "command": "databaseTools.openConnections",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "databaseTools.disconnect",
          "when": "databaseTools.hasActiveConnection"
        },
        {
          "command": "databaseTools.disconnectAll",
          "when": "databaseTools.hasActiveConnection"
        },
        {
          "command": "databaseTools.clearFilter",
          "when": "databaseTools.filtered"
        },
        {
          "command": "databaseTools.groupByEnvironment",
          "when": "!databaseTools.grouped"
        },
        {
          "command": "databaseTools.showFlatList",
          "when": "databaseTools.grouped"
        },
        {
          "command": "databaseTools.collapseAllGroups",
          "when": "databaseTools.grouped"
        },
        {
          "command": "databaseTools.editConnection",
          "when": "false"
        },
        {
          "command": "databaseTools.addFavourite",
          "when": "false"
        },
        {
          "command": "databaseTools.removeFavourite",
          "when": "false"
        },
        {
          "command": "databaseTools.duplicateConnection",
          "when": "false"
        },
        {
          "command": "databaseTools.copyServerAddress",
          "when": "false"
        },
        {
          "command": "databaseTools.enableSchemaMode",
          "when": "false"
        },
        {
          "command": "databaseTools.disableSchemaMode",
          "when": "false"
        },
        {
          "command": "databaseTools.openDefinition",
          "when": "false"
        },
        {
          "command": "databaseTools.selectTop100",
          "when": "false"
        },
        {
          "command": "databaseTools.generateCrud",
          "when": "false"
        },
        {
          "command": "databaseTools.executeObject",
          "when": "false"
        },
        {
          "command": "databaseTools.scriptAsAlter",
          "when": "false"
        },
        {
          "command": "databaseTools.copyObjectName",
          "when": "false"
        },
        {
          "command": "databaseTools.copyObjectFullName",
          "when": "false"
        },
        {
          "command": "databaseTools.addObjectFavourite",
          "when": "false"
        },
        {
          "command": "databaseTools.removeObjectFavourite",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "databaseTools.newConnection",
          "when": "view == databaseTools.connections",
          "group": "navigation@1"
        },
        {
          "command": "databaseTools.refreshConnections",
          "when": "view == databaseTools.connections",
          "group": "navigation@2"
        },
        {
          "command": "databaseTools.viewOptions",
          "when": "view == databaseTools.connections",
          "group": "navigation@3"
        },
        {
          "command": "databaseTools.collapseAllGroups",
          "when": "view == databaseTools.connections && databaseTools.grouped",
          "group": "navigation@4"
        },
        {
          "command": "databaseTools.clearFilter",
          "when": "view == databaseTools.connections && databaseTools.filtered",
          "group": "navigation@5"
        },
        {
          "command": "databaseTools.disconnectAll",
          "when": "view == databaseTools.connections && databaseTools.hasActiveConnection",
          "group": "1_session@1"
        },
        {
          "command": "databaseTools.groupByEnvironment",
          "when": "view == databaseTools.connections && !databaseTools.grouped",
          "group": "2_view@1"
        },
        {
          "command": "databaseTools.showFlatList",
          "when": "view == databaseTools.connections && databaseTools.grouped",
          "group": "2_view@1"
        }
      ],
      "webview/context": [
        {
          "command": "databaseTools.connect",
          "when": "webviewSection == 'connection' && !dbConnectionLive",
          "group": "1_session@1"
        },
        {
          "command": "databaseTools.disconnect",
          "when": "webviewSection == 'connection' && dbConnectionLive",
          "group": "1_session@1"
        },
        {
          "command": "databaseTools.refreshCatalog",
          "when": "webviewSection == 'connection' && dbConnectionLive",
          "group": "1_session@2"
        },
        {
          "command": "databaseTools.addFavourite",
          "when": "webviewSection == 'connection' && !dbConnectionPinned",
          "group": "2_reading@1"
        },
        {
          "command": "databaseTools.removeFavourite",
          "when": "webviewSection == 'connection' && dbConnectionPinned",
          "group": "2_reading@1"
        },
        {
          "command": "databaseTools.enableSchemaMode",
          "when": "webviewSection == 'connection' && !dbSchemaMode",
          "group": "2_reading@2"
        },
        {
          "command": "databaseTools.disableSchemaMode",
          "when": "webviewSection == 'connection' && dbSchemaMode",
          "group": "2_reading@2"
        },
        {
          "command": "databaseTools.editConnection",
          "when": "webviewSection == 'connection'",
          "group": "3_profile@1"
        },
        {
          "command": "databaseTools.duplicateConnection",
          "when": "webviewSection == 'connection'",
          "group": "3_profile@2"
        },
        {
          "command": "databaseTools.copyServerAddress",
          "when": "webviewSection == 'connection'",
          "group": "4_copy@1"
        },
        {
          "command": "databaseTools.deleteConnection",
          "when": "webviewSection == 'connection'",
          "group": "5_danger@1"
        },
        {
          "command": "databaseTools.openDefinition",
          "when": "webviewSection == 'dbObject'",
          "group": "1_open@1"
        },
        {
          "command": "databaseTools.selectTop100",
          "when": "webviewSection == 'dbObject' && dbObjectRelational",
          "group": "1_open@2"
        },
        {
          "command": "databaseTools.executeObject",
          "when": "webviewSection == 'dbObject' && dbObjectRoutine",
          "group": "1_open@3"
        },
        {
          "command": "databaseTools.generateCrud",
          "when": "webviewSection == 'dbObject' && objectKind == 'table'",
          "group": "2_script@1"
        },
        {
          "command": "databaseTools.scriptAsAlter",
          "when": "webviewSection == 'dbObject' && (dbObjectRoutine || objectKind == 'view')",
          "group": "2_script@2"
        },
        {
          "command": "databaseTools.copyObjectName",
          "when": "webviewSection == 'dbObject'",
          "group": "3_copy@1"
        },
        {
          "command": "databaseTools.copyObjectFullName",
          "when": "webviewSection == 'dbObject'",
          "group": "3_copy@2"
        },
        {
          "command": "databaseTools.addObjectFavourite",
          "when": "webviewSection == 'dbObject' && !dbObjectPinned",
          "group": "4_pin@1"
        },
        {
          "command": "databaseTools.removeObjectFavourite",
          "when": "webviewSection == 'dbObject' && dbObjectPinned",
          "group": "4_pin@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "databaseTools",
          "title": "Database Connections",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "databaseTools": [
        {
          "id": "databaseTools.connections",
          "name": "Connections",
          "type": "webview",
          "icon": "media/database.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.36",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
