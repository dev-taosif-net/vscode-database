        {
          "command": "databaseTools.addObjectFavourite",
          "when": "webviewSection == 'dbObject' && !dbObjectPinned",
          "group": "4_pin@1"
        },
        {
          "command": "databaseTools.removeObjectFavourite",
          "when": "webviewSection == 'dbObject' && dbObjectPinned",
          "group": "4_pin@1"
        }
      ],
      "editor/title": [
        {
          "command": "databaseTools.run",
          "when": "databaseTools.sqlTab && !databaseTools.running",
          "group": "navigation@1"
        },
        {
          "command": "databaseTools.cancelQuery",
          "when": "databaseTools.sqlTab && databaseTools.running",
          "group": "navigation@1"
        },
        {
          "command": "databaseTools.explainPlan",
          "when": "databaseTools.sqlTab",
          "group": "navigation@2"
        },
        {
          "command": "databaseTools.formatQuery",
          "when": "databaseTools.sqlTab",
          "group": "navigation@3"
        },
        {
          "command": "databaseTools.bindConnection",
          "when": "databaseTools.sqlTab && resourceScheme != dbquery",
          "group": "navigation@4"
        },
        {
          "command": "databaseTools.runStatement",
          "when": "databaseTools.sqlTab",
          "group": "1_run@1"
        },
        {
          "command": "databaseTools.explainActual",
          "when": "databaseTools.sqlTab",
          "group": "1_run@2"
        },
        {
          "command": "databaseTools.saveQuery",
          "when": "databaseTools.sqlTab",
          "group": "2_keep@1"
        },
        {
          "command": "databaseTools.shareQuery",
          "when": "databaseTools.sqlTab",
          "group": "2_keep@2"
        },
        {
          "command": "databaseTools.disconnectTab",
          "when": "databaseTools.sqlTab",
          "group": "3_session@1"
        }
      ],
      "editor/context": [
        {
          "command": "databaseTools.run",
          "when": "databaseTools.sqlTab && editorTextFocus",
          "group": "1_database@1"
        },
        {
          "command": "databaseTools.runStatement",
          "when": "databaseTools.sqlTab && editorTextFocus",
          "group": "1_database@2"
        },
        {
          "command": "databaseTools.explainPlan",
          "when": "databaseTools.sqlTab && editorTextFocus",
          "group": "1_database@3"
        },
        {
          "command": "databaseTools.saveQuery",
          "when": "databaseTools.sqlTab && editorTextFocus",
          "group": "2_database@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "databaseTools",
          "title": "Database Connections",
          "icon": "media/database.svg"
        }
      ],
      "panel": [
        {
          "id": "databaseToolsResults",
          "title": "Query Results",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "databaseTools": [
        {
          "id": "databaseTools.connections",
          "name": "Connections",
          "type": "webview",
          "icon": "media/database.svg"
        },
        {
          "id": "databaseTools.details",
          "name": "Database Object",
          "type": "webview",
          "icon": "media/database.svg"
        },
        {
          "id": "databaseTools.history",
          "name": "Query History",
          "type": "webview",
          "icon": "media/database.svg"
        }
      ],
      "databaseToolsResults": [
        {
          "id": "databaseTools.results",
          "name": "Results",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.36",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
